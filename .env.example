# Local development. `make up` copies this file to .env on first run.
# Staging and production get these from the ECS task definition and Secrets Manager instead.

# --- Required everywhere ---
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DATABASE_URL=postgres://postgres:postgres@db:5432/app

# --- Optional (defaults shown) ---
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# DJANGO_ADMIN_URL=admin/
# DJANGO_LOG_LEVEL=INFO
# DJANGO_CONN_MAX_AGE=60
# DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com

# --- Production only (config.settings.prod; required unless a default is noted) ---
# DJANGO_ALLOWED_HOSTS=api.yourdomain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com
# DJANGO_ADMIN_URL=manage-7f3k/
# AWS_REGION=ap-south-1
# AWS_STORAGE_BUCKET_NAME=backend-prod-files
# CDN_DOMAIN=dxxxx.cloudfront.net
# SENTRY_DSN=                      (optional)
# SENTRY_ENVIRONMENT=production    (optional)
# SENTRY_TRACES_SAMPLE_RATE=0.0    (optional)
# DJANGO_SECURE_HSTS_SECONDS=31536000 (optional)
