# Local development. `make up` copies this file to .env on first run.
# Staging and production get these from the ECS task definition and Secrets Manager instead.

# --- Required everywhere ---
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-0123456789abcdef
DATABASE_URL=postgres://postgres:postgres@db:5432/app
REDIS_URL=redis://redis:6379/0

# --- Local only ---
# Emails go to Mailpit (http://localhost:8025). Without Docker, use consolemail:// to print them instead.
EMAIL_URL=smtp://mailpit:1025

# --- Optional (defaults shown) ---
# FRONTEND_URL=http://localhost:3000        base of links in emails (password reset)
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# DJANGO_ADMIN_URL=admin/
# DJANGO_LOG_LEVEL=INFO
# DJANGO_CONN_MAX_AGE=60
# DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7

# --- Production only (config.settings.prod; required unless marked optional) ---
# DJANGO_ALLOWED_HOSTS=api.yourdomain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com
# DJANGO_ADMIN_URL=manage-7f3k/
# DJANGO_DEFAULT_FROM_EMAIL=noreply@yourdomain.com   (an SES-verified domain)
# FRONTEND_URL=https://app.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com   (optional; mobile apps don't need it)
# REDIS_URL=rediss://<elasticache-endpoint>:6379/0
# AWS_REGION=ap-south-1
# AWS_STORAGE_BUCKET_NAME=backend-prod-files
# CDN_DOMAIN=dxxxx.cloudfront.net
# WEB_CONCURRENCY=2  GUNICORN_THREADS=4   (optional; gunicorn workers and threads per worker)
# SENTRY_DSN=                      (optional)
# SENTRY_ENVIRONMENT=production    (optional)
# SENTRY_TRACES_SAMPLE_RATE=0.0    (optional)
