{
  "family": "backend-prod",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/backend-prod-execution",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/backend-prod-task",
  "containerDefinitions": [
    {
      "name": "web",
      "image": "ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/backend:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 8000, "protocol": "tcp" }],
      "environment": [
        { "name": "DJANGO_SETTINGS_MODULE", "value": "config.settings.prod" },
        { "name": "DJANGO_ALLOWED_HOSTS", "value": "api.yourdomain.com" },
        { "name": "DJANGO_CSRF_TRUSTED_ORIGINS", "value": "https://api.yourdomain.com" },
        { "name": "DJANGO_ADMIN_URL", "value": "manage-CHANGE-ME/" },
        { "name": "AWS_REGION", "value": "ap-south-1" },
        { "name": "AWS_STORAGE_BUCKET_NAME", "value": "backend-prod-files" },
        { "name": "CDN_DOMAIN", "value": "dxxxx.cloudfront.net" },
        { "name": "SENTRY_ENVIRONMENT", "value": "production" }
      ],
      "secrets": [
        { "name": "DJANGO_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:ap-south-1:ACCOUNT_ID:secret:backend/prod-XXXXXX:DJANGO_SECRET_KEY::" },
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:ap-south-1:ACCOUNT_ID:secret:backend/prod-XXXXXX:DATABASE_URL::" },
        { "name": "SENTRY_DSN", "valueFrom": "arn:aws:secretsmanager:ap-south-1:ACCOUNT_ID:secret:backend/prod-XXXXXX:SENTRY_DSN::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/backend-prod",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
